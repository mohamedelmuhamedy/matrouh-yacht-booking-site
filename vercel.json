{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/dr-travel run build",
  "outputDirectory": "artifacts/dr-travel/dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/googleaebab8491e2a6175.html", "destination": "/googleaebab8491e2a6175.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
